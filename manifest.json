{
    "manifest_version": 3,
    "name": "Contextual/Semantic Search",
    "version": "0.1.0",
    "description": "Perform semantic or contextual searches on the current webpage.",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    }
  }
  