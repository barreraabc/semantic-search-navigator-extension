{
  "name": "Advanced Search",
  "description": "Provide two extra options to the traditional literal search based on string similarity and semantic search.",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Provide more search options to the traditional Ctrl+F",
    "default_icon": {
      "16": "/images/advanced_search16.png",
      "32": "/images/advanced_search32.png",
      "48": "/images/advanced_search48.png",
      "128": "/images/advanced_search128.png"
    }
  },
  "icons": {
    "16": "/images/advanced_search16.png",
    "32": "/images/advanced_search32.png",
    "48": "/images/advanced_search48.png",
    "128": "/images/advanced_search128.png"
  }
}